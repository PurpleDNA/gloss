{
  "name": "gloss",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Select text anywhere and ask an AI about it, in context, without leaving the page.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "icons": "node scripts/make-icons.mjs",
    "tiles": "node scripts/make-tiles.mjs",
    "deploy": "npm run build && node scripts/deploy-windows.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "docs": "node scripts/build-docs.mjs",
    "screenshots": "node scripts/fit-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "preact": "^10.25.3"
  }
}
